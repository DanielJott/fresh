# .env
# Frontend
VITE_MARTIN_URL=http://localhost:3001
VITE_APP_TITLE=Geospatial Viewer

# Processing
PROCESSING_TEST=small  # small, medium, or empty for full
PMTILES_OUTPUT_PATH=/app/output/pmtiles

VITE_MAP_SPRITE_PATH=/sprites/sprite

# Docker
COMPOSE_PROFILES=  # Optional: set to "process" to include processor

# Stage 1: Build
FROM node:25-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --frozen-lockfile

# Copy ALL build configuration files
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY tsconfig.app.json ./
COPY tsconfig.node.json ./
COPY eslint.config.js ./
COPY index.html ./

# Copy source code
COPY src/ ./src/

# Set build environment
ENV NODE_ENV=production

# Build the application
RUN npm run build

# Stage 2: Production
FROM nginx:alpine

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Create sprites directory and copy ALL sprite files
RUN mkdir -p /usr/share/nginx/html/sprites
COPY sprites/sprite*.png /usr/share/nginx/html/sprites/
COPY sprites/sprite*.json /usr/share/nginx/html/sprites/

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Use the built-in nginx user
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx

USER nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
